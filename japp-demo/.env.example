# Created: 2026-11-02 22:53:53 +0800
# Updated: 2026-11-02 22:58:35 +0800
# japp-demo 環境變數範本：cp japp-demo/.env.example japp-demo/.env
# 所有值皆為 podman-compose.yml 的預設值，未改動即可啟動。
#
# 注意：此檔以 env_file 注入 banking-app 容器；compose 的 ${VAR:-default} 插值
# （端口映射、postgres/ES/Kibana 設定等）只讀 shell 環境或專案根目錄 .env。
# 要改端口/密碼請在啟動前 export，或寫入專案根目錄 .env。
# Bob API Key 屬 elk-analyser 服務，請設定在 bob-analyser/.env。

# ── 通用 ──
TZ=Asia/Taipei

# ── Banking App / WAS Liberty ──
LIBERTY_HTTP_PORT=9080
LIBERTY_HTTPS_PORT=9443
JAVA_TOOL_OPTIONS=

# ── ActiveMQ Artemis ──
ARTEMIS_PORT=5672
ARTEMIS_MGMT_PORT=8161
ARTEMIS_USER=admin
ARTEMIS_PASS=admin123

# ── PostgreSQL ──
DB_PORT=50000
DB_NAME=bankdb
DB_USER=bankuser
DB_PASS=bankpassword

# ── Elastic Stack ──
ES_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.13.4
ES_PORT=9200
ES_JAVA_OPTS=-Xms256m -Xmx512m
LOGSTASH_IMAGE=docker.elastic.co/logstash/logstash:8.13.4
LOGSTASH_PORT=5044
KIBANA_IMAGE=docker.elastic.co/kibana/kibana:8.13.4
KIBANA_PORT=5601
