# Updated: 2026-09-15 19:58:12 +0800
# .env.example — 複製為 .env 並填入實際值

# Bob API 金鑰（必填，bob CLI 認證用）
# bob 2.x 使用 BOB_API_KEY；舊版使用 BOBSHELL_API_KEY，兩個皆設可向後相容
BOB_API_KEY=your-api-key-here
BOBSHELL_API_KEY=your-api-key-here

# ── ELK / Elasticsearch 連線（japp-demo ELK Stack）─────────────────────────
# 當 elk-analyser 需要對接 japp-demo 的 Elasticsearch 時，設定以下變數
# 這些值需與 japp-demo/.env 中的 ES 設定一致
# 若 config.yaml 中的 elasticsearch.host 已使用 service 名稱，以下變數僅作文件說明用途

# ES_HOST=elasticsearch          # japp-network 內的 ES hostname（podman-compose 服務名稱）
# ES_PORT=9200
# ES_INDEX=banking-logs-*
# ES_PASSWORD=                   # Demo 環境 security 已關閉，無需密碼

# ── Instana APM 整合（選用）─────────────────────────────────────────
# 需搭配 config.yaml instana.enabled=true 使用
# 觸發路徑：trigger=kibana_alert_instana / webui_instana / cli --with-instana
INSTANA_API_TOKEN=your-instana-api-token-here
